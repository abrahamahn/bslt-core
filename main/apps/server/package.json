{
  "name": "@bslt/server",
  "version": "1.0.0",
  "description": "HTTP server composition root for bslt",
  "main": "dist/src/main.js",
  "exports": {
    ".": {
      "source": "./src/main.ts",
      "types": "./dist/src/main.d.ts",
      "default": "./dist/src/main.js"
    },
    "./bootstrap/app": {
      "source": "./src/bootstrap/app.ts",
      "types": "./dist/src/bootstrap/app.d.ts",
      "default": "./dist/src/bootstrap/app.js"
    },
    "./bootstrap/build-app": {
      "source": "./src/bootstrap/build-app.ts",
      "types": "./dist/src/bootstrap/build-app.d.ts",
      "default": "./dist/src/bootstrap/build-app.js"
    },
    "./bootstrap/context": {
      "source": "./src/bootstrap/context.ts",
      "types": "./dist/src/bootstrap/context.d.ts",
      "default": "./dist/src/bootstrap/context.js"
    },
    "./bootstrap/phases/data": {
      "source": "./src/bootstrap/phases/data.ts",
      "types": "./dist/src/bootstrap/phases/data.d.ts",
      "default": "./dist/src/bootstrap/phases/data.js"
    },
    "./bootstrap/phases/retention": {
      "source": "./src/bootstrap/phases/retention.ts",
      "types": "./dist/src/bootstrap/phases/retention.d.ts",
      "default": "./dist/src/bootstrap/phases/retention.js"
    },
    "./generated/modules": {
      "source": "./src/generated/modules.ts",
      "types": "./dist/src/generated/modules.d.ts",
      "default": "./dist/src/generated/modules.js"
    },
    "./http": {
      "source": "./src/http/index.ts",
      "types": "./dist/src/http/index.d.ts",
      "default": "./dist/src/http/index.js"
    },
    "./http/route-modules": {
      "source": "./src/http/route-modules.ts",
      "types": "./dist/src/http/route-modules.d.ts",
      "default": "./dist/src/http/route-modules.js"
    },
    "./middleware": {
      "source": "./src/middleware/index.ts",
      "types": "./dist/src/middleware/index.d.ts",
      "default": "./dist/src/middleware/index.js"
    },
    "./middleware/cookie": {
      "source": "./src/middleware/cookie.ts",
      "types": "./dist/src/middleware/cookie.d.ts",
      "default": "./dist/src/middleware/cookie.js"
    },
    "./middleware/csrf": {
      "source": "./src/middleware/csrf.ts",
      "types": "./dist/src/middleware/csrf.d.ts",
      "default": "./dist/src/middleware/csrf.js"
    },
    "./middleware/locale": {
      "source": "./src/middleware/locale.ts",
      "types": "./dist/src/middleware/locale.d.ts",
      "default": "./dist/src/middleware/locale.js"
    },
    "./middleware/security": {
      "source": "./src/middleware/security.ts",
      "types": "./dist/src/middleware/security.d.ts",
      "default": "./dist/src/middleware/security.js"
    },
    "./plugin": {
      "source": "./src/plugin/index.ts",
      "types": "./dist/src/plugin/index.d.ts",
      "default": "./dist/src/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx --conditions=source src/main.ts",
    "bootstrap-roles": "node dist/src/bootstrap-roles.js",
    "start": "node --env-file=../../../config/env/.env.production dist/src/main.js",
    "build": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo && tsc -p tsconfig.json && bslt-esm-fix dist",
    "clean": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo",
    "type-check": "tsc -p tsconfig.lint.json",
    "test": "vitest run --reporter=dot --silent=passed-only",
    "test:unit": "vitest run --reporter=dot --test-name-pattern '(unit|fast)'",
    "test:integration": "vitest run --reporter=dot --test-name-pattern '(integration|critical)'",
    "test:full": "vitest run --reporter=verbose",
    "lint": "eslint . --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache-bslt-server --report-unused-disable-directives"
  },
  "dependencies": {
    "@bslt/audit": "workspace:*",
    "@bslt/comms": "workspace:*",
    "@bslt/compliance": "workspace:*",
    "@bslt/contract": "workspace:*",
    "@bslt/db": "workspace:*",
    "@bslt/devtools": "workspace:*",
    "@bslt/identity": "workspace:*",
    "@bslt/realtime": "workspace:*",
    "@bslt/server-system": "workspace:*",
    "@bslt/storage": "workspace:*"
  },
  "devDependencies": {
    "@bslt/build-config": "workspace:*",
    "vitest": "^5.1.0"
  }
}
