{
  "extends": "../../../config/tsconfig.react.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.web-platform.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "eslint.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../client"
    },
    {
      "path": "../contract"
    },
    {
      "path": "../react"
    },
    {
      "path": "../schema"
    },
    {
      "path": "../ui"
    }
  ]
}
