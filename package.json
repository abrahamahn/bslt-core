{
  "name": "@bslt/root",
  "version": "1.0.0",
  "description": "BSLT: a clone-and-own SaaS starter with production-safe defaults.",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "create": "bslt create",
    "quickstart": "bslt init",
    "bootstrap": "bslt setup",
    "dev": "bslt dev server web --with-postgres",
    "dev:core": "bslt dev server web",
    "dev:all": "bslt dev",
    "start": "turbo run start --filter=@bslt/web --filter=@bslt/server",
    "build": "turbo run build --output-logs=errors-only --continue",
    "postbuild": "bslt-esm-fix main/kernel/schema/dist main/kernel/contract/dist main/kernel/protocols/dist main/kernel/db/dist main/kernel/server/dist main/kernel/comms/dist main/modules/identity/dist main/modules/compliance/dist main/modules/audit/dist main/modules/devtools/dist main/kernel/storage/dist main/kernel/realtime/dist main/kernel/client/dist main/kernel/react/dist main/kernel/ui/dist main/kernel/web/dist main/apps/server/dist && bslt gate run esm-dist",
    "gate": "bslt gate merge --concurrency=2",
    "lint": "bslt gate run test-pairs && turbo run lint --continue",
    "lint:fix": "turbo run lint --continue -- --fix",
    "lint:css": "bslt gate run css-tokens responsive dead-classes undefined-tokens",
    "type-check": "turbo run type-check --continue",
    "format": "prettier --config config/.prettierrc --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.cache --write .",
    "format:check": "prettier --config config/.prettierrc --cache --cache-strategy content --cache-location node_modules/.cache/prettier/.cache --check .",
    "test": "turbo run test --output-logs=errors-only --continue -- --coverage.enabled=false",
    "test:coverage": "turbo run test --output-logs=errors-only --continue -- --coverage.enabled=true",
    "test:integration": "pnpm --filter @bslt/tests test:integration",
    "test:postgres-smoke": "pnpm --filter @bslt/tests test:postgres-smoke",
    "test:real-db": "pnpm --filter @bslt/tests test:real-db",
    "test:e2e": "pnpm --filter @bslt/tests test:e2e",
    "ci:full": "bslt gate nightly",
    "ci:everything": "bslt gate nightly && pnpm db:migrate && pnpm test:real-db && pnpm test:postgres-smoke && pnpm test:e2e",
    "clean": "turbo run clean --output-logs=errors-only && rm -rf node_modules",
    "sync:headers": "bslt sync headers",
    "sync:ts": "bslt sync ts",
    "build:theme": "bslt sync theme",
    "audit:docs-links": "bslt gate run docs-links",
    "db:migrate": "bslt db migrate",
    "db:seed": "bslt db seed",
    "db:reset": "bslt db reset",
    "db:bootstrap": "bslt db bootstrap",
    "db:bootstrap:admin": "bslt db bootstrap-admin",
    "db:bootstrap:roles": "bslt db bootstrap-roles",
    "db:audit": "bslt db audit",
    "docker:dev": "docker compose --env-file config/env/.env.local -f infra/docker/development/docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f infra/docker/development/docker-compose.dev.yml down",
    "docker:prod": "docker compose --env-file config/env/.env.production -f infra/docker/production/docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f infra/docker/production/docker-compose.prod.yml down",
    "deploy:demo": "bash infra/docker/demo/local-deploy.sh",
    "prepare": "pnpm hooks:install",
    "hooks:install": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && git config --local core.hooksPath infra/git-hooks && chmod +x infra/git-hooks/pre-commit infra/git-hooks/pre-push || echo 'Skipping hooks install (not a git worktree)'",
    "pre-commit": "bslt sync headers --staged --quiet && lint-staged",
    "pre-push": "bslt pre-push"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --config config/.prettierrc --cache --cache-location node_modules/.cache/prettier/.cache --write",
      "eslint --cache --cache-location node_modules/.cache/eslint/.cache --max-warnings=0 --no-warn-ignored --ignore-pattern config/playwright.config.ts"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --config config/.prettierrc --cache --cache-location node_modules/.cache/prettier/.cache --write"
    ]
  },
  "devDependencies": {
    "@bslt/audit": "workspace:*",
    "@bslt/build-config": "workspace:*",
    "@bslt/compliance": "workspace:*",
    "@bslt/contract": "workspace:*",
    "@bslt/devtools": "workspace:*",
    "@bslt/identity": "workspace:*",
    "@bslt/tools": "workspace:*",
    "@eslint/compat": "^2.1.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^5.4.0",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tar": "7.5.22",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "ajv@^6": "6.14.0",
      "@babel/core": "7.29.6",
      "brace-expansion": "5.0.12",
      "esbuild": "^0.25.12",
      "fast-uri": "3.1.9",
      "fast-xml-parser": "5.8.0",
      "flatted": "3.4.2",
      "handlebars": "4.7.10",
      "js-yaml": "4.3.2",
      "minimatch": "11.0.8",
      "path-to-regexp@0.1.12": "0.1.13",
      "picomatch": "4.0.4",
      "postcss": "8.5.25",
      "qs": "6.15.2",
      "rollup": "4.61.1",
      "ws": "8.21.0",
      "yaml": "2.9.0",
      "find-my-way": "9.7.0"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.2"
}
