# infra/versions.env
# Runtime version pins (restructure plan, section 14.3). The Node.js version is
# pinned in /.node-version; everything else that has a version lives here.
# Dockerfiles, compose files and workflows read these values, and the
# `version-pins` merge gate (main/tools/scripts/audit/version-pins.ts) fails
# when one of them uses another version.
#
# Plain KEY=value lines, readable by `. infra/versions.env` in a shell and by
# `docker compose --env-file`. Image tags were checked against the registry
# when they were set; the PgBouncer image is also pinned by digest because its
# repository is frozen (Bitnami legacy) and gets no new tags.

# PostgreSQL major version: every database in every lane runs this major.
POSTGRES_MAJOR=17
# The exact Postgres image (a minor release of POSTGRES_MAJOR).
POSTGRES_IMAGE=postgres:17.11-alpine
# The connection pooler in front of Postgres in the production compose.
PGBOUNCER_IMAGE=bitnamilegacy/pgbouncer:1.24.1-debian-12-r10@sha256:32c2aefdd8c144f08ee8a0776d4a17387e34f1b77dd9ac8ce92af259d4a7c632
