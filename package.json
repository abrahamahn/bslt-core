{
  "name": "@bslt/root",
  "version": "1.1.0",
  "description": "BSLT core source distribution",
  "private": true,
  "engines": {
    "node": ">=18.19 <25"
  },
  "scripts": {
    "features": "node --import tsx main/tools/features/cli.ts",
    "features:ui": "node --import tsx main/tools/features/ui.ts",
    "db:bootstrap:admin": "pnpm --filter @bslt/server exec node --conditions=source --import tsx src/bootstrap-admin.ts",
    "dev": "pnpm features:check && pnpm --parallel --filter @bslt/server --filter @bslt/web dev",
    "build": "pnpm features:check && pnpm -r --workspace-concurrency=1 run build",
    "type-check": "pnpm features:check && pnpm -r run type-check",
    "test": "node --conditions=source --import tsx --test main/apps/server/src/edition-smoke.test.ts",
    "db:migrate": "pnpm --filter @bslt/server exec node --conditions=source --import tsx src/migrate.ts",
    "start": "pnpm features:check && pnpm --parallel --filter @bslt/server --filter @bslt/web start",
    "features:add": "node --import tsx main/tools/features/cli.ts add",
    "features:update": "node --import tsx main/tools/features/cli.ts update",
    "features:remove": "node --import tsx main/tools/features/cli.ts remove",
    "features:list": "node --import tsx main/tools/features/cli.ts list",
    "features:check": "node --import tsx main/tools/features/cli.ts check",
    "features:available": "node --import tsx main/tools/features/cli.ts available",
    "features:setup": "node --import tsx main/tools/features/cli.ts setup"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --config config/.prettierrc --cache --cache-location node_modules/.cache/prettier/.cache --write",
      "eslint --cache --cache-location node_modules/.cache/eslint/.cache --max-warnings=0 --no-warn-ignored --ignore-pattern config/playwright.config.ts"
    ],
    "*.{json,css,md,yml,yaml}": [
      "prettier --config config/.prettierrc --cache --cache-location node_modules/.cache/prettier/.cache --write"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.0.9",
    "tar": "7.5.22",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "ajv@^6": "6.14.0",
      "@babel/core": "7.29.6",
      "@fastify/static": "10.1.2",
      "brace-expansion": "5.0.9",
      "esbuild": "^0.25.12",
      "fast-uri": "3.1.5",
      "fast-xml-parser": "5.8.0",
      "flatted": "3.4.2",
      "handlebars": "4.7.9",
      "js-yaml": "4.3.0",
      "minimatch": "10.2.5",
      "path-to-regexp@0.1.12": "0.1.13",
      "picomatch": "4.0.4",
      "postcss": "8.5.25",
      "qs": "6.15.2",
      "rollup": "4.61.1",
      "ws": "8.21.0",
      "yaml": "2.9.0",
      "find-my-way": "9.7.0"
    },
    "onlyBuiltDependencies": [
      "argon2",
      "esbuild",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "unrs-resolver"
    ]
  },
  "packageManager": "pnpm@10.26.2"
}
