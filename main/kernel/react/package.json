{
  "name": "@bslt/react",
  "version": "1.0.0",
  "type": "module",
  "description": "React interface for bslt client",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./hooks": {
      "source": "./src/hooks/index.ts",
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    },
    "./router": {
      "source": "./src/router/index.ts",
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo && tsc -p tsconfig.json && bslt-esm-fix dist",
    "lint": "eslint . --cache --cache-location ../../node_modules/.cache/eslint/.eslintcache-bslt-react --report-unused-disable-directives --ignore-pattern src/theme/index.ts",
    "type-check": "tsc -p tsconfig.lint.json",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:coverage": "NODE_OPTIONS=--max-old-space-size=6144 vitest run --coverage.enabled=true",
    "clean": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo"
  },
  "dependencies": {
    "@bslt/client-engine": "workspace:*",
    "@bslt/contract": "workspace:*",
    "@bslt/schema": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@bslt/build-config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/bslt.git",
    "directory": "main/kernel/react"
  }
}
