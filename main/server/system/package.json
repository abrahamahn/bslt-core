{
  "name": "@bslt/server-system",
  "version": "1.0.0",
  "type": "module",
  "description": "Consolidated infrastructure adapters for bslt",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./logger": {
      "source": "./src/logger/index.ts",
      "types": "./dist/logger/index.d.ts",
      "default": "./dist/logger/index.js"
    },
    "./logger/dev": {
      "source": "./src/logger/dev.ts",
      "types": "./dist/logger/dev.d.ts",
      "default": "./dist/logger/dev.js"
    },
    "./cache": {
      "source": "./src/cache/index.ts",
      "types": "./dist/cache/index.d.ts",
      "default": "./dist/cache/index.js"
    },
    "./config": {
      "source": "./src/config/index.ts",
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./security": {
      "source": "./src/security/index.ts",
      "types": "./dist/security/index.d.ts",
      "default": "./dist/security/index.js"
    },
    "./http": {
      "source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./routing": {
      "source": "./src/http/index.ts",
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./observability": {
      "source": "./src/observability/index.ts",
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./runtime": {
      "source": "./src/runtime/index.ts",
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./errors": {
      "source": "./src/errors/index.ts",
      "types": "./dist/errors/index.d.ts",
      "default": "./dist/errors/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo && tsc -p tsconfig.json && node --import tsx ../../tools/scripts/build/ensure-js-extensions.ts dist",
    "clean": "rm -rf dist node_modules/.cache/typescript/*.tsbuildinfo",
    "type-check": "tsc -p tsconfig.lint.json",
    "migrate": "pnpm --filter @bslt/db migrate"
  },
  "keywords": [
    "bslt",
    "infra",
    "infrastructure"
  ],
  "author": "",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/abrahamahn/bslt.git",
    "directory": "main/server/system"
  },
  "bugs": {
    "url": "https://github.com/abrahamahn/bslt/issues"
  },
  "homepage": "https://github.com/abrahamahn/bslt#readme",
  "sideEffects": false,
  "dependencies": {
    "@bslt/shared": "workspace:*",
    "@simplewebauthn/server": "^13.3.2",
    "ioredis": "^5.9.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "optionalDependencies": {},
  "devDependencies": {
    "fastify": "^5.12.1"
  },
  "private": true
}
