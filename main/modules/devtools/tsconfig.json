{
  "extends": "../../../config/tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.devtools.tsbuildinfo"
  },
  "include": [
    "module.ts",
    "contract/**/*.ts",
    "server/**/*.ts",
    "web/**/*.ts",
    "web/**/*.tsx",
    "i18n/**/*.json"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.real-db.test.ts",
    "**/__tests__/**"
  ],
  "references": [
    { "path": "../../kernel/client" },
    { "path": "../../kernel/contract" },
    { "path": "../../kernel/react" },
    { "path": "../../kernel/schema" },
    { "path": "../../kernel/server" },
    { "path": "../../kernel/ui" },
    { "path": "../../kernel/web" }
  ]
}
