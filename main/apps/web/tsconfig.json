{
  "extends": "../../../config/tsconfig.react.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.web.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "eslint.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../kernel/schema"
    },
    {
      "path": "../../kernel/contract"
    },
    {
      "path": "../../kernel/server"
    },
    {
      "path": "../../kernel/client"
    },
    {
      "path": "../../kernel/ui"
    },
    {
      "path": "../../kernel/react"
    },
    {
      "path": "../../kernel/web"
    },
    {
      "path": "../../modules/audit"
    },
    {
      "path": "../../modules/compliance"
    },
    {
      "path": "../../modules/devtools"
    },
    {
      "path": "../../modules/identity"
    }
  ]
}
