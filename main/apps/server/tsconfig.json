{
  "extends": "../../../config/tsconfig.node.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./",
    "composite": true,
    "noEmit": false,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.server.tsbuildinfo"
  },
  "include": ["src/**/*", "src/plugin/errors", "routes"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "eslint.config.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**"
  ],
  "references": [
    {
      "path": "../../kernel/contract"
    },
    {
      "path": "../../kernel/server"
    },
    {
      "path": "../../kernel/db"
    },
    {
      "path": "../../kernel/comms"
    },
    {
      "path": "../../kernel/realtime"
    },
    {
      "path": "../../kernel/storage"
    },
    {
      "path": "../../modules/audit"
    },
    {
      "path": "../../modules/compliance"
    },
    {
      "path": "../../modules/devtools"
    },
    {
      "path": "../../modules/identity"
    }
  ]
}
