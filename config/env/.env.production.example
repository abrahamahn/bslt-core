# =============================================================================
# Starter - .env.production
# =============================================================================

# =============================================================================
# 1. Core Application
# =============================================================================
NODE_ENV=production  # options: development | production | test
APP_NAME=BSLT
HOST=0.0.0.0
PORT=8080
API_PORT=8080
APP_PORT=5173
API_BASE_URL=https://abe.com  # REQUIRED: Set in deployment (e.g., https://your-app.com)
APP_URL=https://abe.com  # REQUIRED: Set in deployment (e.g., https://your-app.com)
# PUBLIC_APP_URL=              # Override for public-facing app URL (priority over APP_URL)
# PUBLIC_API_URL=              # Override for public-facing API URL (priority over VITE_API_URL)
LOG_LEVEL=info  # options: trace | debug | info | warn | error | fatal
LOG_CLIENT_ERROR_LEVEL=warn  # options: trace | debug | info | warn | error | fatal
LOG_REQUEST_CONTEXT=true  # options: true | false
LOG_PRETTY_JSON=false  # options: true | false
MAINTENANCE_MODE=false
AUDIT_RETENTION_DAYS=90  # 0 = unlimited

# =============================================================================
# 2. Frontend (Vite)
# =============================================================================
# Leave VITE_API_URL unset for the bundled Caddy setup so the browser uses relative /api URLs.
# VITE_API_URL=https://api.abe.com
VITE_APP_NAME=BSLT
# Optional starter recipe UI flags. Keep commented until the recipe is enabled.
# VITE_ENABLE_BILLING=false
# VITE_ENABLE_ACTIVITY_FEED=false
# VITE_ENABLE_ADVANCED_ADMIN=false
# VITE_ENABLE_ADVANCED_AUTH=false  # magic-link + email login-code UI; needs `magic` in AUTH_STRATEGIES
# VITE_ENABLE_DEV_CHROME=false     # set true to surface the developer layout chrome (top/left/right/bottom bars) in production
# VITE_ENABLE_DEV_TOOLS=false      # set true to surface developer tooling panels in production

# =============================================================================
# 3. Provider Switches
# =============================================================================
DATABASE_PROVIDER=postgresql  # starter runtime
STORAGE_PROVIDER=local  # options: local | s3
QUEUE_PROVIDER=local  # options: local | redis
CACHE_PROVIDER=redis  # options: local | redis
SEARCH_PROVIDER=sql  # options: sql
EMAIL_PROVIDER=smtp  # options: console | smtp
# BILLING_PROVIDER=               # optional: stripe | paypal (leave unset to disable billing)
# NOTIFICATIONS_PROVIDER=         # optional: onesignal | fcm | courier | generic
AUTH_STRATEGIES=local  # starter default; comma-separated: local, magic, webauthn, google, github, kakao, facebook, microsoft, apple

# =============================================================================
# 4. Auth — Secrets & Tokens
# =============================================================================
JWT_SECRET=
JWT_SECRET_PREVIOUS=
JWT_ISSUER=abe
JWT_AUDIENCE=abe-api
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
REFRESH_TOKEN_GRACE_PERIOD=30
COOKIE_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# =============================================================================
# 5. Auth — Password & Lockout
# =============================================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=24
PASSWORD_MIN_SCORE=3
LOCKOUT_MAX_ATTEMPTS=10
LOCKOUT_DURATION_MS=1800000
MAGIC_LINK_EXPIRY_MINUTES=15
MAGIC_LINK_MAX_ATTEMPTS=3
TOTP_ISSUER=Abe
TOTP_WINDOW=1
CAPTCHA_ENABLED=false  # options: true | false
# CAPTCHA_PROVIDER=turnstile  # options: turnstile
# CAPTCHA_SITE_KEY=
# CAPTCHA_SECRET_KEY=

# =============================================================================
# 6. Auth — OAuth Providers
# =============================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://abe.com/api/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://abe.com/api/auth/oauth/github/callback
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_CALLBACK_URL=https://abe.com/api/auth/oauth/kakao/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=
MICROSOFT_TENANT_ID=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_BASE64=
APPLE_CALLBACK_URL=

# =============================================================================
# 7. CORS / Proxy
# =============================================================================
CORS_ORIGIN=https://your-app.com # REQUIRED: Set in deployment (e.g., https://your-app.com)
# CORS_ORIGINS=                # Comma-separated list (takes priority over CORS_ORIGIN)
TRUST_PROXY=true  # options: true | false
TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8
MAX_PROXY_DEPTH=1

# =============================================================================
# 8. Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
# RATE_LIMIT_LOGIN_MAX=5             # Default: 5 (prod) / 100 (dev)
# RATE_LIMIT_REGISTER_MAX=3          # Default: 3 (prod) / 100 (dev)
# IP blocklist / allowlist — comma-separated exact IPs or CIDR ranges.
# All empty (default) keeps the blocklist middleware inert. Allowlist wins over blocklist.
# IP_BLOCKLIST=                       # Blocked for all routes (standard + strict policy)
# IP_BLOCKLIST_STRICT=                # Additionally blocked only on routes with strict IP policy
# IP_ALLOWLIST=                       # Always permitted (e.g. office egress, health checkers)
# RATE_LIMIT_FORGOT_PASSWORD_MAX=3   # Default: 3 (prod) / 100 (dev)
# RATE_LIMIT_VERIFY_EMAIL_MAX=10     # Default: 10 (prod) / 100 (dev)
# Geo / jurisdiction gate — unset or empty (default) blocks nowhere; it activates
# only when BLOCKED_REGIONS is set, and needs a CDN that supplies location headers
# (without one every request has an unknown location, which is never blocked).
# Health probes under /health are always exempt.
# BLOCKED_REGIONS=                     # Comma-separated COUNTRY or COUNTRY-REGION (e.g. US-WA,CA-ON)
# GEO_COUNTRY_HEADER=cf-ipcountry      # Header carrying the ISO country code
# GEO_REGION_HEADERS=cf-region-code,x-geo-region,cf-region  # First to answer wins

# =============================================================================
# 9. Database
# =============================================================================
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=abe_prod
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DB_MAX_CONNECTIONS=20
DB_SSL=true  # options: true | false
# DATABASE_READ_REPLICA_URL=  # Read replica connection string

# =============================================================================
# 10. Cache / Redis
# =============================================================================
CACHE_USE_REDIS=true  # options: true | false
CACHE_TTL_MS=300000
CACHE_MAX_SIZE=1000
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# =============================================================================
# 11. Queue
# =============================================================================
QUEUE_POLL_INTERVAL_MS=1000
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_BASE_MS=1000
QUEUE_MAX_BACKOFF_MS=300000

# =============================================================================
# 12. Storage
# =============================================================================
STORAGE_ROOT_PATH=/app/uploads
STORAGE_PUBLIC_BASE_URL=https://your-app.com/uploads
# Required if STORAGE_PROVIDER=s3.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=https://s3.amazonaws.com
S3_FORCE_PATH_STYLE=false  # options: true | false
S3_PRESIGN_EXPIRES_IN_SECONDS=3600

# =============================================================================
# 13. Email
# =============================================================================
EMAIL_API_KEY=
EMAIL_FROM_NAME=BSLT
# Required when EMAIL_PROVIDER=smtp.
EMAIL_FROM_ADDRESS=no-reply@abe.com
EMAIL_REPLY_TO=support@abe.com
SMTP_HOST=smtp.mail.abe.com
SMTP_PORT=587
SMTP_SECURE=true  # options: true | false
SMTP_USER=
SMTP_PASS=
SMTP_CONNECTION_TIMEOUT=5000
SMTP_SOCKET_TIMEOUT=30000

# =============================================================================
# 14. Search
# =============================================================================
SQL_SEARCH_DEFAULT_PAGE_SIZE=50
SQL_SEARCH_MAX_PAGE_SIZE=1000
SQL_SEARCH_MAX_QUERY_DEPTH=5
SQL_SEARCH_MAX_CONDITIONS=20
SQL_SEARCH_LOGGING=false  # options: true | false
SQL_SEARCH_TIMEOUT_MS=5000

# =============================================================================
# 15. Billing
# =============================================================================
BILLING_CURRENCY=usd
BILLING_PORTAL_RETURN_URL=https://your-app.com/settings/billing
BILLING_CHECKOUT_SUCCESS_URL=https://your-app.com/billing/success
BILLING_CHECKOUT_CANCEL_URL=https://your-app.com/billing/cancel
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=production  # options: sandbox | production
PAYPAL_WEBHOOK_ID=
PLAN_FREE_ID=plan_free
PLAN_PRO_ID=plan_pro
PLAN_ENTERPRISE_ID=plan_enterprise

# =============================================================================
# 16. Notifications
# =============================================================================
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
ONESIGNAL_USER_AUTH_KEY=
ONESIGNAL_ENABLE_LOGGING=false  # options: true | false
# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# COURIER_API_KEY=
# COURIER_API_URL=https://api.courier.com
# COURIER_ENABLE_LOGGING=false       # options: true | false

# SMS / Phone verification (powers phone verification + SMS 2FA; needs the `comms` capability)
# SMS_ENABLED=false                  # true uses a real provider; otherwise codes are logged to the console
# SMS_PROVIDER=console               # options: console | twilio
# SMS_FROM=                          # default sender number in E.164 format (e.g. +15555550123)
# TWILIO_ACCOUNT_SID=                # required when SMS_PROVIDER=twilio
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=                # falls back to SMS_FROM when unset

# =============================================================================
# 17. Error Tracking (Sentry)
# =============================================================================
# Required for production error tracking; get this from Sentry project settings.
SENTRY_DSN=
# RELEASE_VERSION=  # Git SHA or semver — set by CI, e.g. ${{ github.sha }}

# =============================================================================
# 18. OpenTelemetry Distributed Tracing
# =============================================================================
OTEL_ENABLED=false  # options: true | false — set to true to enable tracing
# OTEL_SERVICE_NAME=bslt-server            # Service name shown in the trace UI
# OTEL_SERVICE_VERSION=1.0.0               # Service version shown in the trace UI
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318  # OTLP collector (Jaeger / Grafana Tempo / etc)
# OTEL_EXPORTER_OTLP_HEADERS=             # Optional auth headers, e.g. "Authorization=Bearer <token>"
# OTEL_TRACES_SAMPLER=parentbased_traceidratio  # Recommended for production: sample a fraction
# OTEL_TRACES_SAMPLER_ARG=0.1             # 10% sampling rate (adjust to taste)

# =============================================================================
# 18. Package Manager
# =============================================================================
PACKAGE_MANAGER_PROVIDER=pnpm  # options: pnpm | npm | yarn
NPM_AUDIT=true
NPM_LEGACY_PEER_DEPS=false
NPM_REGISTRY=https://registry.npmjs.org/
PNPM_STRICT_PEER_DEPS=true
PNPM_FROZEN_LOCKFILE=true
PNPM_REGISTRY=https://registry.npmjs.org/
YARN_AUDIT=true
YARN_FROZEN_LOCKFILE=true
YARN_REGISTRY=https://registry.npmjs.org/
