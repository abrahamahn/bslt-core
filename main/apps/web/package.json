{
  "name": "@bslt/web",
  "version": "1.0.0",
  "description": "React web application for bslt",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm build:server && node --import tsx scripts/prerender.ts",
    "build:server": "VITE_SSR=true vite build",
    "start": "vite preview --port 4173",
    "type-check": "tsc -p tsconfig.lint.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bslt/api": "workspace:*",
    "@bslt/client-engine": "workspace:*",
    "@bslt/react": "workspace:*",
    "@bslt/shared": "workspace:*",
    "@bslt/ui": "workspace:*",
    "@simplewebauthn/browser": "^14.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "vite": "^8.3.6",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "private": true
}
