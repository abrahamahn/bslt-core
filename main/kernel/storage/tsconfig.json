{
  "extends": "../../../config/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "typeRoots": ["../../../node_modules/@types"],
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.storage.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "vitest.config.ts",
    "eslint.config.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/__tests__/**"
  ],
  "references": [
    {
      "path": "../contract"
    },
    {
      "path": "../protocols"
    }
  ]
}
